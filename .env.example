# ============================================================================
# DMC Immigration Group — .env.example (DOCUMENTATION ONLY — NOT ACTIVE)
# ----------------------------------------------------------------------------
# This file is committed and non-secret. It is NEVER loaded by the application
# or tests. Copy its keys once into the single active root `.env` (gitignored)
# and maintain only `.env` thereafter. For deployment, mirror final `.env`
# values into Vercel Environment Variables; do not create extra env files.
# Placeholder values below are unmistakably non-functional. Replace every
# `replace_*` / `example.*` value with reviewed production values before
# enabling the related integration; the app fails closed otherwise.
# ============================================================================

# Site and routing
SITE_URL=https://www.dmcimmigrationgroup.com
SITE_NAME="DMC Immigration Group"
DEFAULT_MARKET=dubai
GEO_ROUTING_ENABLED=true
LEGACY_HOST_REDIRECTS_ENABLED=true
MARKET_COOKIE_NAME=dmc_market
MARKET_COOKIE_MAX_AGE_SECONDS=31536000

# Email delivery (Resend) — RESEND_ENABLED may only be true after the sending
# domain is verified in Resend and real values are supplied.
RESEND_ENABLED=true
RESEND_API_KEY=re_replace_with_real_key
RESEND_SENDING_DOMAIN=resend.dev
RESEND_FROM_LOCAL_PART=onboarding
RESEND_FROM_NAME="DMC Website"
# Sandbox mode: sends only to the account owner dmcimmigrationgroup@gmail.com.
# Verify a sending domain in Resend before routing leads to other inboxes.
RESEND_REPLY_TO_EMAIL=dmcimmigrationgroup@gmail.com
RESEND_CENTRAL_BCC_EMAIL=

# CRM adapter — disabled by default; endpoint and auth are env-only.
CRM_ENABLED=false
CRM_BASE_URL=https://crm.example.invalid
CRM_LEADS_ENDPOINT=/api/leads
CRM_API_KEY=replace_me
CRM_AUTH_HEADER=Authorization
CRM_AUTH_SCHEME=Bearer
CRM_TIMEOUT_MS=8000

# Optional anti-abuse adapter — disabled until credentials supplied.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=replace_me
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_me
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PROVIDER=none
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Guided conversion UI
GUIDED_CHAT_ENABLED=true
# Chatbot lead recipient (Resend) — this email ID is for the guided chat bot lead.
# Chat leads are emailed here when a visitor completes the chat. Change this to redirect chat leads.
DMC_CHATBOT_LEAD_TO_EMAIL=website@dm-consultant.com
ELIGIBILITY_CHECKER_ENABLED=true

# Consent and measurement — integrations stay off until real IDs are supplied
# and consent behavior is client/legal reviewed.
CONSENT_BANNER_ENABLED=false
CONSENT_COOKIE_NAME=dmc_consent
CONSENT_POLICY_REVISION=1
ANALYTICS_ENABLED=false
GTM_CONTAINER_ID=
GA4_MEASUREMENT_ID=
MARKETING_TRACKING_ENABLED=false
META_PIXEL_ID=

# Public social/profile links
SOCIAL_INSTAGRAM_URL=
SOCIAL_FACEBOOK_URL=
SOCIAL_YOUTUBE_URL=

# Legal/trust contact — TODO(client): real fraud-report address.
FRAUD_REPORT_EMAIL=replace-fraud-report@example.invalid

# Per-market public contact and lead routing.
